# Copy this file to `.env` and fill in your key. `.env` is git-ignored.
# Real environment variables take precedence over these values.

# --- How the photo is read ------------------------------------------------
# vision: one multimodal call reads the board and explains every dish.
#         20-70 s per photo, best on phone photos, no bounding boxes.
# ocr:    easyocr + layout + a text-only model call. 150-300 s on the same
#         boards, weaker on dense Chinese, but it returns box coordinates.
MENU_EXTRACTOR=vision
# glm-4.5v and glm-4v-flash both work with this key although neither is listed
# by GET /api/paas/v4/models.
MENU_VISION_MODEL=glm-4.5v
# glm-4.5v accepts `disabled` and is slightly faster, but with reasoning off it
# invented 13 nameless rows for a cropped price column. Keep `low`.
MENU_VISION_THINKING=low
# Longest side before the photo is downscaled (0 disables). Small text on a
# dense board loses legibility fast, so this is generous on purpose.
MENU_VISION_MAX_SIDE=2400
MENU_VISION_QUALITY=90
MENU_VISION_TIMEOUT=180

# --- Zhipu / BigModel (works with the key you already have) ---------------
# glm-5.3-flash: free tier, always reasons (cannot be switched off).
# glm-4.5-flash responds reliably too and does allow thinking=disabled.
MENU_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MENU_LLM_MODEL=glm-5.3-flash
MENU_LLM_API_KEY=

# --- DeepSeek ------------------------------------------------------------
# MENU_LLM_BASE_URL=https://api.deepseek.com/v1
# MENU_LLM_MODEL=deepseek-flash

# --- Alibaba DashScope (cheapest paid tier) ------------------------------
# MENU_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MENU_LLM_MODEL=qwen-flash

# --- Optional tuning -----------------------------------------------------
# Reasoning effort: low | high | max (glm-5.x always reasons, `disabled` gets
# HTTP 400 code 1210 and the client falls back to low). Use `auto` to omit the
# parameter, or `disabled` on models that support it (glm-4.x): ~2x faster.
MENU_LLM_THINKING=low
# glm-5.3-flash collapses the reply to a single record when this is on, so it is
# off here. Leave it on (1) for providers that need the JSON guarantee.
MENU_LLM_JSON_MODE=0
# Items per model call (default 40). 30-item menus came back correctly; lower
# this only if you ever see descriptions drift onto the wrong dish.
MENU_LLM_BATCH=40
MENU_LLM_RETRIES=2

# --- Taste memory and recommendations ------------------------------------
# Where profile.json and events.jsonl live. This is user data, not cache: it
# holds the stated party size, budget and restrictions, plus the like/dislike
# log the recommender learns from. Deleted = amnesia, nothing else breaks.
# MENU_DATA_DIR=data
# Ranked dishes shown under the meal plan (default 12).
# MENU_RECOMMEND_SHORTLIST=12
